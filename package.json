{
  "name": "role-play-engine",
  "version": "0.1.0",
  "description": "LangGraph-based multi-agent starter written in TypeScript.",
  "type": "module",
  "main": "dist/src/shared/index.js",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --apply .",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "prisma generate",
    "build": "swc src -d dist",
    "build:turbo": "turbo build",
    "build:swc": "swc src -d dist",
    "build:tsc": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "chat": "tsx client/server.ts",
    "chat:frontend": "cd client && npm run dev",
    "chat:dev": "concurrently \"pnpm chat\" \"pnpm chat:frontend\"",
    "clean": "rm -rf dist client/dist client/dist-server && rm -rf node_modules client/node_modules || true",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:agent-decisions": "tsx scripts/test-agent-decisions.ts",
    "lint:agent-cases": "tsx scripts/lint-agent-decision-cases.ts",
    "verify:module-migration": "node --import tsx scripts/verify-module-migration.ts"
  },
  "keywords": [
    "role-play",
    "simulation",
    "multi-agent",
    "typescript"
  ],
  "author": "Role Play Engine",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "fastembed": "^1.14.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "nodemailer": "^6.9.15",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "recharts": "^2.10.3",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.3.100",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.10.0",
    "@types/ws": "^8.5.13",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.19",
    "better-sqlite3": "^12.6.2",
    "cross-env": "^7.0.3",
    "only-allow": "^1.2.1",
    "postcss": "^8.4.38",
    "prisma": "^6.0.0",
    "react-markdown": "^9.0.1",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.19.0",
    "turbo": "^2.4.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.7"
}
