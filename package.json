{
  "name": "role-play-engine",
  "version": "0.1.0",
  "description": "TypeScript role-playing simulation engine with autonomous NPCs.",
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --apply .",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "prisma generate",
    "build": "swc src -d dist",
    "build:turbo": "turbo build",
    "build:swc": "swc src -d dist",
    "build:tsc": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "chat": "tsx client/server.ts",
    "chat:frontend": "pnpm --dir client dev",
    "chat:dev": "pnpm chat & pnpm chat:frontend & wait",
    "clean": "rm -rf dist client/dist client/dist-server && rm -rf node_modules client/node_modules || true",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:agent-decisions": "tsx scripts/test-agent-decisions.ts",
    "test:grayhaven-sanity": "tsx scripts/test-grayhaven-sanity.ts",
    "smoke:module": "tsx scripts/smoke-module-load.ts",
    "lint:agent-cases": "tsx scripts/lint-agent-decision-cases.ts",
    "prompt:budget": "tsx scripts/analyze-prompt-budget.ts",
    "sim:full": "tsx scripts/full-injection-run.ts",
    "verify:module-migration": "node --import tsx scripts/verify-module-migration.ts"
  },
  "keywords": ["role-play", "simulation", "multi-agent", "typescript"],
  "author": "Role Play Engine",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-validator": "^7.2.0",
    "fastembed": "^1.14.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "openai": "^4.104.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.3.100",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "@types/ws": "^8.5.13",
    "@vitest/ui": "^2.1.8",
    "only-allow": "^1.2.1",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.4.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.7"
}
