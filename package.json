{
  "name": "coc-multiagent",
  "version": "0.1.0",
  "description": "LangGraph-based multi-agent starter written in TypeScript.",
  "type": "module",
  "main": "dist/src/coc_multiagents_system/index.js",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --apply .",
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm rebuild better-sqlite3 && swc src -d dist",
    "build:turbo": "turbo build",
    "build:swc": "pnpm rebuild better-sqlite3 && swc src -d dist",
    "build:tsc": "pnpm rebuild better-sqlite3 && tsc -p tsconfig.json",
    "start": "node dist/src/coc_multiagents_system/index.js",
    "dev": "tsx src/coc_multiagents_system/index.ts",
    "dev:debug": "cross-env NODE_ENV=development DEBUG=coc:* tsx src/coc_multiagents_system/index.ts",
    "chat": "tsx client/server.ts",
    "chat:frontend": "cd client && npm run dev",
    "chat:dev": "concurrently \"pnpm chat\" \"pnpm chat:frontend\"",
    "clean": "rm -rf dist client/dist client/dist-server && rm -rf node_modules client/node_modules || true",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:scene-npc": "node test-scene-npc-extraction.mjs"
  },
  "keywords": ["langgraph", "langchain", "multi-agent", "typescript"],
  "author": "CoC AI",
  "license": "MIT",
  "dependencies": {
    "@langchain/anthropic": "^0.3.8",
    "@langchain/core": "^1.0.1",
    "@langchain/google-genai": "^0.1.0",
    "@langchain/langgraph": "^1.0.4",
    "@langchain/openai": "^0.3.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "fastembed": "^1.14.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.8",
    "mammoth": "^1.8.0",
    "nodemailer": "^6.9.15",
    "pdf-parse": "^1.1.1",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.3.100",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "@types/pdf-parse": "^1.1.4",
    "@types/ws": "^8.5.13",
    "@vitest/ui": "^2.1.8",
    "cross-env": "^7.0.3",
    "only-allow": "^1.2.1",
    "turbo": "^2.4.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "react-markdown": "^9.0.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.7"
}
