# CoC Multi-Agent System Environment Variables
# Copy this file to .env and fill in your actual values


# Model Provider Configuration
# Options: openai, google, anthropic, groq, ollama, openrouter
MODEL_PROVIDER=google
# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic API Configuration (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# Google Gemini API Configuration (Optional)
GOOGLE_API_KEY=""
SMALL_GOOGLE_MODEL="gemini-2.0-flash"     # Default: gemini-1.5-flash-latest
MEDIUM_GOOGLE_MODEL="gemini-2.5-flash"   # Default: gemini-1.5-flash-latest
LARGE_GOOGLE_MODEL="gemini-2.0-flash" 

# Database Configuration
DATABASE_PATH=./data/db.sqlite

# Server Configuration
PORT=3000
HOST=localhost

# Development Configuration
NODE_ENV=development
DEBUG=coc:*

# Logging Configuration
LOG_LEVEL=info
VERBOSE=false
