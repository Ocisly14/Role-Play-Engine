# CoC Multi-Agent System Environment Variables
# Copy this file to .env and fill in your actual values


# Model Provider Configuration
# Options: openai, anthropic, google, deepseek
MODEL_PROVIDER=google
# World Builder model provider (module generation only). Defaults to openai if unset.
# WORLD_BUILDER_MODEL_PROVIDER=openai
# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic API Configuration (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# DeepSeek API Configuration (Optional)
# All three model classes default to deepseek-chat: it is the model with
# function calling, and every LLM seam here forces a tool call.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_URL="https://api.deepseek.com/v1"   # override for a gateway
# DEEPSEEK_MAX_TOKENS=64000                        # input/context budget, not the output cap
# SMALL_DEEPSEEK_MODEL="deepseek-chat"
# MEDIUM_DEEPSEEK_MODEL="deepseek-chat"
# LARGE_DEEPSEEK_MODEL="deepseek-chat"

# Google Gemini API Configuration (Optional)
GOOGLE_API_KEY=""
SMALL_GOOGLE_MODEL="gemini-2.0-flash"     # Default: gemini-1.5-flash-latest
MEDIUM_GOOGLE_MODEL="gemini-2.5-flash"   # Default: gemini-1.5-flash-latest
LARGE_GOOGLE_MODEL="gemini-2.0-flash" 

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database?schema=public&connection_limit=N
# connection_limit: Maximum number of database connections (default: 10, recommended: 50 for production)
# pool_timeout: Connection pool timeout in seconds (default: 10)
DATABASE_URL="postgresql://postgres:password@localhost:5432/coc_game_db?schema=public&connection_limit=50&pool_timeout=20"

# Server Configuration
PORT=3000
HOST=localhost

# Development Configuration
NODE_ENV=development
DEBUG=coc:*

# Logging Configuration
LOG_LEVEL=info
VERBOSE=false

# JWT Configuration - IMPORTANT: Change this in production!
JWT_SECRET="CHANGE-THIS-TO-A-SECURE-RANDOM-STRING"
JWT_EXPIRES_IN="60m"
JWT_REFRESH_EXPIRES_IN="60m"
SESSION_IDLE_TIMEOUT_MINUTES="60"

# Email Service Configuration (for Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"  # Use App Password, not account password
EMAIL_FROM="noreply@cocgame.com"

# Referral Codes — synced to DB on every restart.
# Format: "CODE" for unlimited uses, or "CODE_N" to allow exactly N uses.
# Add more by incrementing the number. Removing a code here does NOT delete it from DB.
REFERRAL_CODE_1="BH6XK_5"
REFERRAL_CODE_2="ZLDM6_5"
REFERRAL_CODE_3="YIJNF_5"

# Analytics Configuration
ADMIN_EMAIL="test@test.com"  # Comma-separated list of admin emails
ENABLE_ANALYTICS_SCHEDULER="true"  # Set to false to disable daily scheduler
