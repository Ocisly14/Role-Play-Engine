  "relationships": [
    {
      "targetId": "npc_anita_batra",
      "targetName": "Anita Batra",
      "relationshipType": "family",
      "attitude": 85,
      "firstPerson": "我们家能在灰港站稳，一半靠我的烙铁，一半靠 Anita 的烤箱；后一半大概更多。"
    },
    {
      "targetId": "npc_priya_batra",
      "targetName": "Priya Batra",
      "relationshipType": "family",
      "attitude": 80,
      "firstPerson": "Priya 的焊点比我十三岁时漂亮。她把报废机箱当零件库，我知道；她也许不接铺子，但她知道怎样把事情记清楚。"
    },
    {
      "targetId": "npc_dolores_medeiros",
      "targetName": "Dolores Medeiros",
      "relationshipType": "friend",
      "attitude": 70,
      "firstPerson": "Dolores 当年收下 Anita 的曲奇，这份情我记着。她的收音机我修了十二年不收钱，她也从不让我空手走。"
    },
    {
      "targetId": "npc_marisol_reyes",
      "targetName": "Marisol Reyes",
      "relationshipType": "neutral",
      "attitude": 50,
      "firstPerson": "Marisol 跟我们一样，把日子算到小数点后两位。她店里的灯也在闪，旧线路不是完整解释。"
    },
    {
      "targetId": "npc_doc_weaver",
      "targetName": "Doc Weaver",
      "relationshipType": "friend",
      "attitude": 65,
      "firstPerson": "Doc 是镇上少数先要数据再下结论的人。他管我的血压，我管他的留声机。"
    },
    {
      "targetId": "npc_ray_holt",
      "targetName": "Ray Holt",
      "relationshipType": "neutral",
      "attitude": 35,
      "firstPerson": "Ray 警长对警局收音机的串台只说能响就行；这不是一个维护问题应有的回答。"
    },
    {
      "targetId": "npc_cole_baxter",
      "targetName": "Cole Baxter",
      "relationshipType": "neutral",
      "attitude": 50,
      "firstPerson": "Cole 取修好的机器总会签字留副本，做事很有章法。"
    },
    {
      "targetId": "npc_earl_pruitt",
      "targetName": "Earl Pruitt",
      "relationshipType": "neutral",
      "attitude": 55,
      "firstPerson": "Earl 保养灯塔机械三十年，手艺是真的。能做到那种程度的人，眼睛和脑子不至于像大家说的那样坏。"
    },
    {
      "targetId": "npc_frank_holt",
      "targetName": "Frank Holt",
      "relationshipType": "neutral",
      "attitude": 45,
      "firstPerson": "Frank 的货车保养得比全镇任何电视都好。他对工作守合同，我也不逼他谈不愿谈的事。"
    },
    {
      "targetId": "npc_susan_holt",
      "targetName": "Susan Holt",
      "relationshipType": "neutral",
      "attitude": 55,
      "firstPerson": "Susan 能把一整间候诊室安顿下来，是个妥帖的人。"
    },
    {
      "targetId": "npc_tommy_reyes",
      "targetName": "Tommy Reyes",
      "relationshipType": "neutral",
      "attitude": 40,
      "firstPerson": "Tommy 胆子太大；只要他别把我的万用表带走，我不干涉孩子们的暑假。"
    },
    {
      "targetId": "npc_denny_holt",
      "targetName": "Denny Holt",
      "relationshipType": "neutral",
      "attitude": 45,
      "firstPerson": "Denny 爱读书，也该学会有些东西不能只从书里解决。"
    }
