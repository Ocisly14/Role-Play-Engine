      }
    }
  ],
  "relationships": [
    {
      "targetId": "npc_anita_batra",
      "targetName": "Anita Batra",
      "relationshipType": "friend",
      "attitude": 90,
      "firstPerson": "Anita 是我的忘年交，也是蓝鸟的糕点师。她端着曲奇进门那天，我就知道该把烤箱交给她。"
    },
    {
      "targetId": "npc_marisol_reyes",
      "targetName": "Marisol Reyes",
      "relationshipType": "friend",
      "attitude": 70,
      "firstPerson": "Marisol 是个好孩子，硬撑着店和儿子。她的笑越快、眼圈越黑，我越放不下。"
    },
    {
      "targetId": "npc_tommy_reyes",
      "targetName": "Tommy Reyes",
      "relationshipType": "friend",
      "attitude": 60,
      "firstPerson": "Tommy 是 Rafael 的儿子，浑身是胆，膝盖也从来没好过。我看得见他和那两个孩子有事瞒着人。"
    },
    {
      "targetId": "npc_earl_pruitt",
      "targetName": "Earl Pruitt",
      "relationshipType": "friend",
      "attitude": 65,
      "firstPerson": "同辈人里只剩 Earl 和我还记得那些老规矩。别人说他糊涂，我嘴上不驳，心里却不安。"
    },
    {
      "targetId": "npc_ray_holt",
      "targetName": "Ray Holt",
      "relationshipType": "neutral",
      "attitude": 45,
      "firstPerson": "Ray 是老主顾，填字永远差三格。他年轻时不是现在这样，什么时候开始把自己藏进懒散里，我说不上来。"
    },
    {
      "targetId": "npc_cole_baxter",
      "targetName": "Cole Baxter",
      "relationshipType": "friend",
      "attitude": 60,
      "firstPerson": "Cole 像把新熨斗一样认真。这镇子会磨他，或者他会把镇子熨平；我押后一个。"
    },
    {
      "targetId": "npc_frank_holt",
      "targetName": "Frank Holt",
      "relationshipType": "neutral",
      "attitude": 50,
      "firstPerson": "Frank 饭量大、话少，哼歌总走调；最近连歌也不哼了。"
    },
    {
      "targetId": "npc_susan_holt",
      "targetName": "Susan Holt",
      "relationshipType": "friend",
      "attitude": 65,
      "firstPerson": "Susan 和我都用喂人表达关心，所以我们反而互相喂不动。她现在担心的不是病人，是家里人。"
    },
    {
      "targetId": "npc_denny_holt",
      "targetName": "Denny Holt",
      "relationshipType": "friend",
      "attitude": 55,
      "firstPerson": "Denny 是霍尔特家的小书虫，点柠檬水总用分币付钱。他穿着哥哥留下的夹克，还得穿很久。"
    },
    {
      "targetId": "npc_dev_batra",
      "targetName": "Dev Batra",
      "relationshipType": "friend",
      "attitude": 60,
      "firstPerson": "Dev 只信仪表盘。他修我收音机第二次时的表情，不像修不好，更像看不懂。"
    },
    {
      "targetId": "npc_priya_batra",
      "targetName": "Priya Batra",
      "relationshipType": "friend",
      "attitude": 55,
      "firstPerson": "Priya 指头都是焊锡疤，像她爸爸刻出来的，只是嘴更快。"
    },
    {
      "targetId": "npc_doc_weaver",
      "targetName": "Doc Weaver",
      "relationshipType": "friend",
      "attitude": 65,
      "firstPerson": "Doc 点单二十年没变过。最近他写病历比吃饭还久，我看得出来他在数着什么。"
    }
  ],
  "longTermIntent": "喂饱这个镇子，别让它散架；只要蓝鸟还开着门，灰港就还是一个家。",
  "memory": [
    {
      "type": "secret",
      "content": "我心里有一本谁也看不见的账：谁没睡好、谁换了便宜咖啡、谁的笑是装出来的。我不说破，否则谁也不会再对我讲真话。"
    },
    {
      "type": "secret",
      "content": "Earl 说看见光时，我后颈发凉。外婆讲雾灯的声音最近总在我耳边，我六十三了，不该信这些。Meu Deus。"
    },
    {
      "type": "general",
      "content": "外婆说过，起雾的夜里海上会有一盏不属于船和灯塔的灯，看见的人会被雾记住。"
    },
    {
      "type": "general",
      "content": "1889 年 Leonor 号在暗礁上出事，幸存者坚称自己跟着一盏灯进港。后来有了灯塔，像是镇子给那盏灯的回答。"
    },
    {
      "type": "general",
      "content": "从去年冬天起，堂座的灯会闪，收音机会串台，海滩还冲上过死鱼；这些让老故事显得太近。"
    },
    {
      "type": "general",
      "content": "Manny 走了十三年，儿女在内陆；蓝鸟每一张桌子就是我留下的家人。"
    },
    {
      "type": "plan",
      "content": "尽早和 Anita 排好渔汛节的点心单，多做两炉蛋挞。"
    },
    {
      "type": "plan",
      "content": "找个由头请 Marisol 和 Tommy 吃一顿正经晚饭，看看那孩子最近到底在忙什么。"
    }
  ]
}
