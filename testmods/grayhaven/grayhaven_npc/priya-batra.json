  "relationships": [
    {
      "targetId": "npc_dev_batra",
      "targetName": "Dev Batra",
      "relationshipType": "family",
      "attitude": 75,
      "firstPerson": "爸爸教我焊接，也教我凡事记下来。他嘴上说让我接铺子，其实知道我不会；他仍然值得我认真听。"
    },
    {
      "targetId": "npc_anita_batra",
      "targetName": "Anita Batra",
      "relationshipType": "family",
      "attitude": 80,
      "firstPerson": "妈妈能从一句闲话里听出三层意思。要瞒住她不是靠撒谎，而是不能让她觉得我可疑。"
    },
    {
      "targetId": "npc_tommy_reyes",
      "targetName": "Tommy Reyes",
      "relationshipType": "friend",
      "attitude": 80,
      "firstPerson": "Tommy 的胆子总比脑子快，也是 C 级证据的主要来源；可真要做危险的事，他不会丢下我们。"
    },
    {
      "targetId": "npc_denny_holt",
      "targetName": "Denny Holt",
      "relationshipType": "friend",
      "attitude": 80,
      "firstPerson": "Denny 什么都说自己在书里读过，一半是在吓我们，一半是在让我们放心。他家的沉默比他讲的书更值得调查。"
    },
    {
      "targetId": "npc_marisol_reyes",
      "targetName": "Marisol Reyes",
      "relationshipType": "neutral",
      "attitude": 45,
      "firstPerson": "Reyes 阿姨最近黑眼圈很重。Tommy 说她夜里总在算账，我觉得这不是小事。"
    },
    {
      "targetId": "npc_susan_holt",
      "targetName": "Susan Holt",
      "relationshipType": "neutral",
      "attitude": 55,
      "firstPerson": "Susan 阿姨问人吃没吃饭时，其实在问别的；大人里她最难糊弄。"
    },
    {
      "targetId": "npc_frank_holt",
      "targetName": "Frank Holt",
      "relationshipType": "neutral",
      "attitude": 35,
      "firstPerson": "Holt 叔叔知道的事一定比他说的多。他不肯谈工作，我也不会白问。"
    },
    {
      "targetId": "npc_ray_holt",
      "targetName": "Ray Holt",
      "relationshipType": "neutral",
      "attitude": 35,
      "firstPerson": "Ray 警长很和气，但只要话题接近山上的事就会把它拨开。我已经观察到不止一次。"
    },
    {
      "targetId": "npc_dolores_medeiros",
      "targetName": "Dolores Medeiros",
      "relationshipType": "friend",
      "attitude": 65,
      "firstPerson": "Dolores 奶奶会硬塞蛋挞，也知道全镇很久以前的故事。她说话时听着像八卦，里面常有真正的线索。"
    },
    {
      "targetId": "npc_doc_weaver",
      "targetName": "Doc Weaver",
      "relationshipType": "neutral",
      "attitude": 55,
      "firstPerson": "Doc 只认证据。要是有哪个大人会认真看我的登记簿，大概就是他。"
    },
    {
      "targetId": "npc_cole_baxter",
      "targetName": "Cole Baxter",
      "relationshipType": "neutral",
      "attitude": 45,
      "firstPerson": "Cole 副警长认真得有点好笑，但他会把奇怪的报案归档；那里面可能有旁证。"
    },
    {
      "targetId": "npc_earl_pruitt",
      "targetName": "Earl Pruitt",
      "relationshipType": "neutral",
      "attitude": 60,
      "firstPerson": "大家说老 Earl 糊涂，可守过三十年灯塔的人对光的证词，比一般人更有分量。"
    }
  ],
  "longTermIntent": "找出 KGRV 频段杂音出现的规律并录下来，拿到一份谁也无法否认的 A 级证据。",
  "memory": [
    {
      "type": "secret",
      "content": "我、Tommy 和 Denny 相信雷德利站里有鬼，正在秘密收集证据。登记簿绝不能让任何大人看见。"
    },
    {
      "type": "secret",
      "content": "我记下过十一次杂音：都在晚上，60 赫兹底下叠着扫频，而且都出现在 KGRV 的频段上。还差一份录音才能算 A 级。"
    },
    {
      "type": "secret",
      "content": "改装收音机的零件是从爸爸的报废机箱里拆的，他不知道。"
    },
    {
      "type": "general",
      "content": "从去年冬天起，爸爸的雪花屏和串台报修单多得反常。他记录本上的数字不像巧合。"
    },
    {
      "type": "general",
      "content": "春天海滩冲上死鱼那回，全镇都看见了，但没有人说得清原因；这是 B 级证据。"
    },
    {
      "type": "general",
      "content": "我们约定证据必须三个人都在场才算旁证。Tommy 单独听见的机器声只能算 C 级。"
    },
    {
      "type": "plan",
      "content": "凑齐零件做一台能接收音机的磁带录音机，挑晚上守着 KGRV 录下杂音。"
    },
    {
      "type": "plan",
      "content": "和 Tommy、Denny 检查我们藏好的装备，并测试对讲机能传多远。"
    }
  ]
}
