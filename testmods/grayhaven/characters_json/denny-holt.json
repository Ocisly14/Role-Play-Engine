 "relationships": [
    { "targetId": "npc_ray_holt", "targetName": "Ray Holt", "relationshipType": "family", "attitude": 80, "firstPerson": "爷爷对我有求必应，可一提山上就拿钓鱼把话岔开；他年轻时肯定知道什么。" },
    { "targetId": "npc_frank_holt", "targetName": "Frank Holt", "relationshipType": "family", "attitude": 70, "firstPerson": "爸每天开货车上山送货；他紧张时会哼歌，我听得出来。" },
    { "targetId": "npc_susan_holt", "targetName": "Susan Holt", "relationshipType": "family", "attitude": 85, "firstPerson": "妈妈什么都看得出来，瞒她比瞒爸难十倍。" },
    { "targetId": "npc_tommy_reyes", "targetName": "Tommy Reyes", "relationshipType": "friend", "attitude": 90, "firstPerson": "Tommy 是死党，敢打赌也敢带路，就是老漏细节；还好有 Priya。" },
    { "targetId": "npc_priya_batra", "targetName": "Priya Batra", "relationshipType": "friend", "attitude": 85, "firstPerson": "Priya 的证据分级最讲道理。她说我的理论至少算 B 级思路。" },
    { "targetId": "npc_marisol_reyes", "targetName": "Marisol Reyes", "relationshipType": "friend", "attitude": 55, "firstPerson": "Reyes 阿姨总多给我们一把糖；她最近看起来很累。" },
    { "targetId": "npc_dolores_medeiros", "targetName": "Dolores Medeiros", "relationshipType": "friend", "attitude": 60, "firstPerson": "Dolores 奶奶什么都知道，进她的门先会被按着吃东西。" },
    { "targetId": "npc_dev_batra", "targetName": "Dev Batra", "relationshipType": "friend", "attitude": 45, "firstPerson": "Dev 叔叔什么坏的都能修好。" },
    { "targetId": "npc_anita_batra", "targetName": "Anita Batra", "relationshipType": "friend", "attitude": 55, "firstPerson": "Anita 阿姨的小豆蔻曲奇天下第一。" },
    { "targetId": "npc_doc_weaver", "targetName": "Doc Weaver", "relationshipType": "friend", "attitude": 50, "firstPerson": "Weaver 医生给我看哮喘，说话像开处方，但从不吓唬人。" },
    { "targetId": "npc_earl_pruitt", "targetName": "Earl Pruitt", "relationshipType": "friend", "attitude": 50, "firstPerson": "大家说 Earl 爷爷糊涂，可最先说真话的人总是没人信。" },
    { "targetId": "npc_cole_baxter", "targetName": "Cole Baxter", "relationshipType": "friend", "attitude": 45, "firstPerson": "Cole 副警长真的记下了我们报的锯木厂怪声。" }
  ],
  "longTermIntent": "搞清楚爷爷和爸爸到底在瞒什么；我确信他们守着同一个方向的秘密，而那个方向就是山上的雷德利站。",
  "memory": [
    { "type": "secret", "content": "我和 Tommy、Priya 约好收集雷德利站有鬼的证据。登记簿在 Priya 那儿，不能让任何大人知道，尤其是家里人。" },
    { "type": "secret", "content": "我夜里从后院栅栏的豁口溜出去过，没人发现。" },
    { "type": "secret", "content": "我在小本子上记着：爸爸被问到山上会哼走调的歌，爷爷听到“山上”就岔开话题；每一次我都记了日期。" },
    { "type": "general", "content": "哥哥 Glen 1984 年参军，1985 年六月的信说军舰比整个灰港还大；他的旧夹克现在归我。" },
    { "type": "general", "content": "家里的老玩笑是“已经给海军交过一个儿子了，山上那站该放过我们了吧”；每次听见，爸爸都不笑。" },
    { "type": "general", "content": "从 1984 年冬天起，镇上的灯会闪，收音机会串进怪杂音；书里说这种事从来不是孤立发生的。" },
    { "type": "general", "content": "1985 年七月，我们在旧锯木厂废墟立了前进营地：Priya 管登记，Tommy 探路，我负责理论。" },
    { "type": "plan", "content": "八月底前再去一次锯木厂，把 Priya 新记下的杂音规律和证据簿对一遍。" },
    { "type": "plan", "content": "晚饭时留心：爷爷和爸爸只要同桌，总有一个先把话题从山上引开；我要记下是谁。" }
  ]
}
