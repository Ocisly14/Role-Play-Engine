  "relationships": [
    {
      "targetId": "npc_dev_batra",
      "targetName": "Dev Batra",
      "relationshipType": "family",
      "attitude": 85,
      "firstPerson": "Dev 还是那个先报参数再说话的人。最近他合上记录本的样子不对，可他若说再等等，我会给他一点时间。"
    },
    {
      "targetId": "npc_priya_batra",
      "targetName": "Priya Batra",
      "relationshipType": "family",
      "attitude": 85,
      "firstPerson": "Priya 嘴硬心软，和她父亲一个模子。她书包不离身、晚饭心不在焉，我不戳破，但我数着呢。"
    },
    {
      "targetId": "npc_dolores_medeiros",
      "targetName": "Dolores Medeiros",
      "relationshipType": "friend",
      "attitude": 90,
      "firstPerson": "Dolores 是我在灰港的半个母亲。1973 年她先尝了我的曲奇，也先给了我一张能安身的工作台。"
    },
    {
      "targetId": "npc_marisol_reyes",
      "targetName": "Marisol Reyes",
      "relationshipType": "friend",
      "attitude": 65,
      "firstPerson": "Marisol 和我一样在撑一间店，却比我难得多。她笑得越来越快，是不想让人多问。"
    },
    {
      "targetId": "npc_susan_holt",
      "targetName": "Susan Holt",
      "relationshipType": "friend",
      "attitude": 65,
      "firstPerson": "Susan 用问人吃了吗的方式关心人，和我一样。她上周对着凉掉的咖啡发呆，心里显然压着事。"
    },
    {
      "targetId": "npc_frank_holt",
      "targetName": "Frank Holt",
      "relationshipType": "neutral",
      "attitude": 45,
      "firstPerson": "Frank 以前每周五带全家来吃晚饭，近来只说累，Susan 便替他带一份派走。"
    },
    {
      "targetId": "npc_ray_holt",
      "targetName": "Ray Holt",
      "relationshipType": "neutral",
      "attitude": 40,
      "firstPerson": "Ray 警长每天喝咖啡填字，说镇上没事。一个人把这句话说太多次，往往是在说给自己听。"
    },
    {
      "targetId": "npc_cole_baxter",
      "targetName": "Cole Baxter",
      "relationshipType": "neutral",
      "attitude": 55,
      "firstPerson": "Cole 认真得让人心疼，咖啡放三块糖还会不好意思。"
    },
    {
      "targetId": "npc_doc_weaver",
      "targetName": "Doc Weaver",
      "relationshipType": "friend",
      "attitude": 60,
      "firstPerson": "Doc 说话像开处方，心却是热的。他留在镇上二十多年，说明这地方也能留住城里人。"
    },
    {
      "targetId": "npc_earl_pruitt",
      "targetName": "Earl Pruitt",
      "relationshipType": "friend",
      "attitude": 60,
      "firstPerson": "大家拿 Earl 当怪人，我不笑。被人当成外来人或怪人的滋味，我家都懂；他说看见了光，我信他看见了。"
    },
    {
      "targetId": "npc_tommy_reyes",
      "targetName": "Tommy Reyes",
      "relationshipType": "friend",
      "attitude": 55,
      "firstPerson": "Tommy 嘴甜，常来讨蛋挞边角；他和 Priya、Denny 凑在一起时准没安生，但都是好孩子。"
    },
    {
      "targetId": "npc_denny_holt",
      "targetName": "Denny Holt",
      "relationshipType": "friend",
      "attitude": 55,
      "firstPerson": "Denny 总是先说自己在书里读到过什么。他年纪不大，心思却比该有的重。"
    }
  ],
  "longTermIntent": "让灰港彻底忘记“外来人”曾被用在 Batra 家身上，让这个姓氏理所当然地属于镇子。",
  "memory": [
    {
      "type": "secret",
      "content": "1973 年背后叫过我外来人的那些名字，我一个都没忘，连 Dev 也没说过。如今他们吃我的糕点，这比道歉更有用。"
    },
    {
      "type": "secret",
      "content": "后厨门帘挡不住堂座的声音。我听过镇上一半的心事，从不外传；这才是我真正的本钱。"
    },
    {
      "type": "general",
      "content": "后厨的 KGRV 收音机近来总会串进沙沙声，拍两下能暂时安静，过一会儿又回来。"
    },
    {
      "type": "general",
      "content": "这阵子堂座都在聊灯闪、死鱼和 Earl 看见的光。我先把蛋挞端上去，嘴里有东西时，人说话不会那么刻薄。"
    },
    {
      "type": "general",
      "content": "Dolores 当年说，灰港接纳我们家，是从胃开始的。这句话我记到今天。"
    },
    {
      "type": "general",
      "content": "Priya 最近总带着灰尘和心事回家。Dev 说十三岁都这样，但我知道孩子们正在瞒着什么。"
    },
    {
      "type": "plan",
      "content": "这周和 Dolores 定下渔汛节的糕点单子，试做一炉掺小豆蔻的葡式蛋挞。"
    },
    {
      "type": "plan",
      "content": "找个周五请 Holt 一家吃顿晚饭；饭桌上的话比诊所里的真。"
    }
  ]
}
