# CoC AI Agent - Production Environment Variables
#
# This file contains production-specific environment variables.
# Copy this to /home/ubuntu/app/.env on your production server and fill in actual values.
#
# SECURITY WARNING: NEVER commit the actual .env file to version control!

# ============================================
# AI Model Provider Configuration (REQUIRED)
# ============================================
# Choose one: openai, google, anthropic
MODEL_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-actual-openai-key-here
SMALL_OPENAI_MODEL=gpt-4o-mini
MEDIUM_OPENAI_MODEL=gpt-4o

# Google Gemini Configuration (Alternative)
# MODEL_PROVIDER=google
# GOOGLE_API_KEY=your-google-api-key-here
# SMALL_GOOGLE_MODEL=gemini-2.0-flash
# MEDIUM_GOOGLE_MODEL=gemini-2.5-flash

# Anthropic Claude Configuration (Alternative)
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ============================================
# Database Configuration
# ============================================
DATABASE_PATH=/home/ubuntu/app/data/coc_game.db

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
PORT=3000
HOST=localhost

# ============================================
# JWT Authentication (CRITICAL - MUST CHANGE!)
# ============================================
# Generate a secure random string for JWT_SECRET:
#   openssl rand -base64 48
#
# IMPORTANT: This MUST be changed to a secure random value in production!
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHARACTER_RANDOM_STRING
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_IDLE_TIMEOUT_MINUTES=60

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
VERBOSE=false

# ============================================
# Email Service (Optional - for password reset)
# ============================================
# Gmail SMTP Configuration
# Note: Use App Password, not your regular Gmail password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=noreply@your-domain.com

# ============================================
# Production Setup Checklist
# ============================================
# Before deploying to production, ensure:
# [ ] MODEL_PROVIDER is set correctly
# [ ] API keys are valid and have sufficient quota
# [ ] JWT_SECRET is changed to a secure random value (use openssl rand -base64 48)
# [ ] DATABASE_PATH points to the correct location
# [ ] SMTP credentials are configured (if using email features)
# [ ] File permissions are set: chmod 600 /home/ubuntu/app/.env
